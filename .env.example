# Hash da senha: dotnet run --project src/ControlCenter.Api --no-launch-profile -- hash-password "sua senha"
# O hash pode conter "=": mantenha as aspas simples.
CC_USUARIO=admin
CC_SENHA_HASH=''
# Pelo menos 32 caracteres aleatórios. No PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
CC_CHAVE_JWT=''
