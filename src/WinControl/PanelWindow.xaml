<Window
    x:Class="WinControl.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Win Control">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- páginas: início, lâmpada, projetar (deslizam como as Configurações rápidas) -->
        <Frame x:Name="Nav" />

        <!-- rodapé como o das Configurações rápidas -->
        <Border Grid.Row="1" Padding="20,10" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <TextBlock Text="Win Control" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Padding="8,6"
                        ToolTipService.ToolTip="Configurações">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Opening="Menu_Opening">
                            <ToggleMenuFlyoutItem x:Name="MiAutostart" Text="Iniciar com o Windows" Click="MiAutostart_Click" />
                            <ToggleMenuFlyoutItem x:Name="MiAutoTheme" Text="Tema segue a Luz Noturna" Click="MiAutoTheme_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Editar cenas e agenda" Click="MiEdit_Click" />
                            <MenuFlyoutItem Text="Abrir log" Click="MiLog_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Sair" Click="MiExit_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
