<Page
    x:Class="WinControl.Pages.LampPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- cabeçalho: voltar + título + liga/desliga -->
        <Grid Padding="8,12,20,8">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,8" Click="Back_Click"
                        ToolTipService.ToolTip="Voltar">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lâmpada" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="Status" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <ToggleSwitch x:Name="Power" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                          Toggled="Power_Toggled" />
        </Grid>

        <Grid x:Name="Body" Grid.Row="1" Padding="20,4,20,16" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- esquerda: brilho e cor -->
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE706;" FontSize="16" ToolTipService.ToolTip="Brilho" />
                    <Slider x:Name="Brightness" Grid.Column="1" Minimum="1" Maximum="100" ValueChanged="Brightness_Changed" />
                    <TextBlock x:Name="BrightnessText" Grid.Column="2" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged">
                    <SelectorBarItem x:Name="WhiteItem" Text="Branco" />
                    <SelectorBarItem x:Name="ColorItem" Text="Cor" />
                </SelectorBar>

                <!-- temperatura (modo branco): faixa do quente ao frio -->
                <StackPanel x:Name="WhitePanel" Spacing="4">
                    <Grid>
                        <TextBlock Text="Temperatura" />
                        <TextBlock x:Name="TempText" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Slider x:Name="Temperature" Minimum="0" Maximum="100" ValueChanged="Temperature_Changed">
                        <Slider.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFA640" Offset="0" />
                                <GradientStop Color="#FFF4E0" Offset="0.5" />
                                <GradientStop Color="#AACDFF" Offset="1" />
                            </LinearGradientBrush>
                        </Slider.Background>
                    </Slider>
                </StackPanel>

                <!-- cor (modo cor): roda de cores do Windows, reduzida para caber -->
                <Viewbox x:Name="ColorBox" Height="190" Visibility="Collapsed">
                    <ColorPicker x:Name="ColorWheel" ColorSpectrumShape="Ring" ColorSpectrumComponents="HueSaturation"
                                 IsColorPreviewVisible="False" IsColorSliderVisible="False"
                                 IsColorChannelTextInputVisible="False" IsHexInputVisible="False"
                                 IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                 ColorChanged="ColorWheel_ColorChanged" />
                </Viewbox>
            </StackPanel>

            <!-- direita: predefinições e timer -->
            <StackPanel Grid.Column="1" Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Predefinições" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Button Tag="1,0" Click="Preset_Click" HorizontalAlignment="Stretch" Padding="4,8">
                            <StackPanel>
                                <TextBlock Text="Noite" HorizontalAlignment="Center" />
                                <TextBlock Text="1%" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Tag="35,15" Click="Preset_Click" HorizontalAlignment="Stretch" Padding="4,8">
                            <StackPanel>
                                <TextBlock Text="Relaxar" HorizontalAlignment="Center" />
                                <TextBlock Text="35%" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Tag="50,50" Click="Preset_Click" HorizontalAlignment="Stretch" Padding="4,8">
                            <StackPanel>
                                <TextBlock Text="Padrão" HorizontalAlignment="Center" />
                                <TextBlock Text="50%" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Tag="100,100" Click="Preset_Click" HorizontalAlignment="Stretch" Padding="4,8">
                            <StackPanel>
                                <TextBlock Text="Foco" HorizontalAlignment="Center" />
                                <TextBlock Text="100%" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- timer: clicar no ativo cancela -->
                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock Text="Desligar em" />
                        <TextBlock x:Name="TimerText" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <Grid x:Name="Timers" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ToggleButton Tag="15" Content="15 min" Click="Timer_Click" HorizontalAlignment="Stretch" />
                        <ToggleButton Grid.Column="1" Tag="30" Content="30 min" Click="Timer_Click" HorizontalAlignment="Stretch" />
                        <ToggleButton Grid.Row="1" Tag="60" Content="1 h" Click="Timer_Click" HorizontalAlignment="Stretch" />
                        <ToggleButton Grid.Row="1" Grid.Column="1" Tag="120" Content="2 h" Click="Timer_Click" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
