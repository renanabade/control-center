<Page
    x:Class="WinControl.Pages.DualSensePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- cabeçalho: voltar + título + status da conexão -->
        <StackPanel Orientation="Horizontal" Spacing="4" Padding="8,12,20,8">
            <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,8" Click="Back_Click"
                    ToolTipService.ToolTip="Voltar">
                <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Controle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="Status" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Padding="20,4,20,16" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- esquerda: cor e intensidade da barra de luz -->
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE706;" FontSize="16" ToolTipService.ToolTip="Intensidade da luz" />
                    <Slider x:Name="Intensity" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="Intensity_Changed" />
                    <TextBlock x:Name="IntensityText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <!-- cor por modo: a roda edita a cor do modo que está valendo -->
                <Grid>
                    <TextBlock x:Name="ColorLabel" Text="Cor por modo" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="PerMode" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="PerMode_Toggled" />
                </Grid>
                <!-- os 5 LEDs brancos abaixo do touchpad -->
                <Grid>
                    <TextBlock Text="LED de jogador" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="PlayerLeds" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="PlayerLeds_Toggled" />
                </Grid>
                <Viewbox Height="130">
                    <ColorPicker x:Name="ColorWheel" ColorSpectrumShape="Ring" ColorSpectrumComponents="HueSaturation"
                                 IsColorPreviewVisible="False" IsColorSliderVisible="False"
                                 IsColorChannelTextInputVisible="False" IsHexInputVisible="False"
                                 IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                 ColorChanged="ColorWheel_ColorChanged" />
                </Viewbox>
            </StackPanel>

            <!-- direita: modo de emulação -->
            <StackPanel Grid.Column="1" Spacing="8">
                <ToggleSwitch x:Name="Auto" Header="Automático por jogo" Toggled="Auto_Toggled" />
                <Grid>
                    <TextBlock x:Name="GameLine" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,40,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="Forget" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Padding="8,6"
                            Click="Forget_Click" ToolTipService.ToolTip="Esquecer este jogo e consultar a Steam de novo">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </Grid>
                <TextBlock x:Name="ModeTitle" Text="Emular como" />
                <ToggleButton x:Name="ModeNative" Tag="DualSense" Click="Mode_Click" HorizontalAlignment="Stretch" Padding="8,10">
                    <StackPanel>
                        <TextBlock Text="DualSense" HorizontalAlignment="Center" />
                        <TextBlock Text="Nativo, sem emulação" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ModeX360" Tag="Xbox360" Click="Mode_Click" HorizontalAlignment="Stretch" Padding="8,10">
                    <StackPanel>
                        <TextBlock Text="Xbox 360" HorizontalAlignment="Center" />
                        <TextBlock Text="Funciona em quase todo jogo" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ModePs4" Tag="Ps4" Click="Mode_Click" HorizontalAlignment="Stretch" Padding="8,10">
                    <StackPanel>
                        <TextBlock Text="PS4" HorizontalAlignment="Center" />
                        <TextBlock Text="DualShock 4, ícones PlayStation" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="Hint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
