<Page
    x:Class="WinControl.Pages.ConfigGeralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="28,24" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Geral" Style="{StaticResource SubtitleTextBlockStyle}" />

            <Border Style="{StaticResource ConfigCardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="Autostart" Header="Iniciar com o Windows" Toggled="Autostart_Toggled" />
                    <ToggleSwitch x:Name="TemaAuto" Header="O tema segue a Luz Noturna" Toggled="Opcao_Toggled" Tag="tema_automatico" />
                    <ToggleSwitch x:Name="TelasJuntas" Header="Mexer no brilho de uma tela muda todas" Toggled="Opcao_Toggled" Tag="telas_juntas" />
                    <ToggleSwitch x:Name="Agenda" Header="Agenda das telas ativa" Toggled="Opcao_Toggled" Tag="agenda_ativa" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ConfigCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Levar para outro PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Exportar cria na Área de Trabalho um arquivo protegido por senha, com lâmpadas, cenas, agenda, controle e periféricos. Leve-o para o outro PC e clique em Importar. Na mesma rede, as lâmpadas aparecem sozinhas." />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="O arquivo contém as chaves das lâmpadas. Guarde a senha e nunca coloque o arquivo no repositório do projeto, que é público." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Exportar" Click="Exportar_Click" />
                        <Button Content="Importar" Click="Importar_Click" />
                    </StackPanel>
                    <InfoBar x:Name="Aviso" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ConfigCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Arquivos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Cenas e agenda ainda são editadas no arquivo. O app percebe a mudança e recarrega sozinho." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Editar cenas e agenda" Click="Cenas_Click" />
                        <Button Content="Abrir pasta de configuração" Click="Pasta_Click" />
                        <Button Content="Abrir log" Click="Log_Click" />
                    </StackPanel>
                    <TextBlock x:Name="Local" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
