<Page
    x:Class="WinControl.Pages.PerifericosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- cabeçalho: voltar + título + status -->
        <StackPanel Orientation="Horizontal" Spacing="4" Padding="8,12,20,8">
            <Button Style="{StaticResource SubtleButtonStyle}" Padding="10,8" Click="Back_Click"
                    ToolTipService.ToolTip="Voltar">
                <FontIcon Glyph="&#xE76B;" FontSize="12" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Periféricos" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="Status" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Padding="20,4,20,16" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- esquerda: qual aparelho, seguir o controle, brilho -->
            <StackPanel Spacing="14">
                <SelectorBar x:Name="Which" SelectionChanged="Which_SelectionChanged">
                    <SelectorBarItem x:Name="MouseItem" Text="Mouse" />
                    <SelectorBarItem x:Name="KeyboardItem" Text="Teclado" />
                </SelectorBar>
                <Grid>
                    <TextBlock Text="Seguir a cor do controle" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="Follow" HorizontalAlignment="Right" OnContent="" OffContent="" MinWidth="0"
                                  Toggled="Follow_Toggled" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE706;" FontSize="16" ToolTipService.ToolTip="Brilho" />
                    <Slider x:Name="Brightness" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="Brightness_Changed" />
                    <TextBlock x:Name="BrightnessText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock x:Name="Hint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- só teclado: cor por tecla. Aperta a tecla de verdade para escolher; a roda passa a editar ela -->
                <StackPanel x:Name="KeysPanel" Spacing="6">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="PickKey" Content="Escolher tecla" HorizontalAlignment="Stretch" Click="PickKey_Click" />
                        <Button x:Name="RemoveKey" Grid.Column="1" Click="RemoveKey_Click" ToolTipService.ToolTip="Tirar a cor desta tecla">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2" Click="ClearKeys_Click" ToolTipService.ToolTip="Tirar a cor de todas as teclas">
                            <FontIcon Glyph="&#xE894;" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="KeyLine" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- direita: cor própria (desligada quando segue o controle) -->
            <Viewbox Grid.Column="1" Height="190">
                <ColorPicker x:Name="ColorWheel" ColorSpectrumShape="Ring" ColorSpectrumComponents="HueSaturation"
                             IsColorPreviewVisible="False" IsColorSliderVisible="False"
                             IsColorChannelTextInputVisible="False" IsHexInputVisible="False"
                             IsAlphaEnabled="False" IsMoreButtonVisible="False"
                             ColorChanged="ColorWheel_ColorChanged" />
            </Viewbox>
        </Grid>
    </Grid>
</Page>
